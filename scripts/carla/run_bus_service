#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
output_dir="${1:-${repo_root}/log/bus-service-$(date +%Y%m%d-%H%M%S)}"
if (($#)); then shift; fi
mkdir -p "$output_dir"
exec 9>"${TMPDIR:-/tmp}/carla-bus-control-validation.lock"
flock -n 9 || { echo "Another bus driving test is running." >&2; exit 1; }
container=selfcar-carla-autoware
if docker exec "$container" pgrep -f '^python3 .*carla_bus_(control_validation|lap|service).py' >/dev/null; then
  echo "A bus driving test is already running." >&2
  exit 1
fi
headless=false
for argument in "$@"; do
  [[ "$argument" != --headless ]] || headless=true
done
if ! "$headless" && ! docker exec "$container" sh -c 'test -n "$(fc-list :lang=ko)"'; then
  # Use an installed host font; keep font binaries out of the repository.
  font_path="${CARLA_BUS_UI_FONT:-$(fc-match -f '%{file}' 'sans:lang=ko')}"
  [[ -f "$font_path" ]] || { echo "Set CARLA_BUS_UI_FONT to an installed Korean font." >&2; exit 1; }
  docker exec "$container" mkdir -p /usr/local/share/fonts/carla-bus-ui
  docker cp "$font_path" "$container:/usr/local/share/fonts/carla-bus-ui/$(basename -- "$font_path")"
  docker exec "$container" fc-cache -f /usr/local/share/fonts/carla-bus-ui
  docker exec "$container" sh -c 'test -n "$(fc-list :lang=ko)"' || {
    echo "The selected font does not provide Korean glyphs." >&2; exit 1;
  }
fi
docker exec "$container" mkdir -p /tmp/bus-tools
for name in carla_bus_service.py carla_bus_service_policy.py carla_bus_lap.py carla_bus_course_traffic.py carla_bus_following.py carla_bus_ring_policy.py carla_bus_route_policy.py carla_bus_signal_audit.py carla_bus_control_validation.py carla_closed_loop_validation.py carla_validation_actors.py carla_native_lane_check.py; do
  docker cp "$repo_root/tools/$name" "$container:/tmp/bus-tools/"
done
docker cp "$repo_root/scenarios/bus/town05_bus_route.json" "$container:/tmp/bus-tools/"
python3 - "$repo_root" "$output_dir" <<'PY'
import hashlib
import json
from pathlib import Path
import subprocess
import sys

root, output = map(Path, sys.argv[1:])
sources = list((root/'tools').glob('carla_bus_*.py')) + [
    root/'tools/carla_closed_loop_validation.py', root/'tools/carla_validation_actors.py',
    root/'tools/carla_native_lane_check.py', root/'scenarios/bus/town05_bus_route.json',
    root/'scripts/carla/run_bus_service']
record = {
    'git_head': subprocess.check_output(['git', '-C', str(root), 'rev-parse', 'HEAD'], text=True).strip(),
    'runtime_image': subprocess.check_output(
        ['docker', 'inspect', '--format', '{{.Image}}', 'selfcar-carla-autoware'], text=True).strip(),
    'source_sha256': {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest() for p in sources},
}
(output/'inputs.json').write_text(json.dumps(record, indent=2)+'\n')
PY
report="/tmp/bus-service-$$.json"
interrupt_service() {
  docker exec "$container" pkill -INT -f "^python3 /tmp/bus-tools/carla_bus_service.py .*--output ${report}$" || true
}
trap interrupt_service INT TERM
set +e
docker exec "$container" bash -lc '
  source /opt/ros/jazzy/setup.bash && source /opt/autoware/setup.bash &&
  source /opt/selfcar_overlay/setup.bash && source /opt/carla_overlay/setup.bash &&
  report="$1"; shift
  python3 /tmp/bus-tools/carla_bus_service.py --route /tmp/bus-tools/town05_bus_route.json "$@" --output "$report"
' bash "$report" "$@" 2>&1 | tee "$output_dir/service.log"
result=${PIPESTATUS[0]}
set -e
if docker exec "$container" test -f "$report"; then
  docker cp "$container:$report" "$output_dir/service.json"
fi
echo "Service output: $output_dir (exit=$result)"
exit "$result"
