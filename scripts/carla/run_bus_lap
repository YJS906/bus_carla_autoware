#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
output_dir="${1:-${repo_root}/log/bus-lap-$(date +%Y%m%d-%H%M%S)}"
if (($#)); then shift; fi
mkdir -p "$output_dir"
exec 9>"${TMPDIR:-/tmp}/carla-bus-control-validation.lock"
flock -n 9 || { echo "Another bus driving test is running." >&2; exit 1; }
container=selfcar-carla-autoware
if docker exec "$container" pgrep -f '^python3 .*carla_bus_(control_validation|lap).py' >/dev/null; then
  echo "A bus driving test is already running." >&2
  exit 1
fi
docker exec "$container" mkdir -p /tmp/bus-tools
for name in carla_bus_lap.py carla_bus_course_traffic.py carla_bus_following.py carla_bus_ring_policy.py carla_bus_route_policy.py carla_bus_signal_audit.py carla_bus_control_validation.py carla_closed_loop_validation.py carla_validation_actors.py carla_native_lane_check.py; do
  docker cp "$repo_root/tools/$name" "$container:/tmp/bus-tools/"
done
docker cp "$repo_root/scenarios/bus/town05_bus_route.json" "$container:/tmp/bus-tools/"
report="/tmp/bus-lap-$$.json"
interrupt_lap() {
  docker exec "$container" pkill -INT -f "^python3 /tmp/bus-tools/carla_bus_lap.py .*--output ${report}$" || true
}
trap interrupt_lap INT TERM
set +e
docker exec "$container" bash -lc '
  source /opt/ros/jazzy/setup.bash && source /opt/autoware/setup.bash &&
  source /opt/selfcar_overlay/setup.bash && source /opt/carla_overlay/setup.bash &&
  report="$1"; shift
  python3 /tmp/bus-tools/carla_bus_lap.py --route /tmp/bus-tools/town05_bus_route.json "$@" --output "$report"
' bash "$report" "$@" 2>&1 | tee "$output_dir/lap.log"
result=${PIPESTATUS[0]}
set -e
if docker exec "$container" test -f "$report"; then
  docker cp "$container:$report" "$output_dir/lap.json"
fi
echo "Lap output: $output_dir (exit=$result)"
exit "$result"
